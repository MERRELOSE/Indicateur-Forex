// v3.0 SMART MONEY - Advanced ICT Filters

//@version=6
indicator("📊 Forex Sessions PRO v3 - Smart Money Filters", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================================================================
// PARAMÈTRES UTILISATEUR
// ============================================================================

// === TIMEZONE ===
tz_offset = input.int(1, 'Fuseau Horaire UTC (+/-)', minval=-12, maxval=14, group='🌍 Timezone')
use_exchange_tz = input(false, 'Utiliser le fuseau de l\'exchange', group='🌍 Timezone')

// === SESSIONS ===
show_nya = input(true, '', inline='nya', group='📍 Sessions')
nya_name = input.string('New York', '', inline='nya', group='📍 Sessions')
nya_time = input.session('1300-2200', '', inline='nya', group='📍 Sessions')
nya_color = input.color(#ff5d00, '', inline='nya', group='📍 Sessions')

show_ldn = input(true, '', inline='ldn', group='📍 Sessions')
ldn_name = input.string('Londres', '', inline='ldn', group='📍 Sessions')
ldn_time = input.session('0700-1600', '', inline='ldn', group='📍 Sessions')
ldn_color = input.color(#2157f3, '', inline='ldn', group='📍 Sessions')

show_tyo = input(true, '', inline='tyo', group='📍 Sessions')
tyo_name = input.string('Tokyo', '', inline='tyo', group='📍 Sessions')
tyo_time = input.session('0000-0900', '', inline='tyo', group='📍 Sessions')
tyo_color = input.color(#e91e63, '', inline='tyo', group='📍 Sessions')

// === KILL ZONES ===
show_kz = input(true, 'Afficher Kill Zones', group='🎯 Kill Zones')
london_kz_time = input.session('0800-1100', 'London Kill Zone', group='🎯 Kill Zones')
ny_kz_time = input.session('1300-1600', 'New York Kill Zone', group='🎯 Kill Zones')
london_kz_color = input.color(color.red, 'Couleur London KZ', group='🎯 Kill Zones')
ny_kz_color = input.color(color.blue, 'Couleur NY KZ', group='🎯 Kill Zones')

// === FILTRES SMART MONEY ===
enable_fvg_filter = input(true, '⚡ Fair Value Gaps (FVG)', group='🧠 Smart Money Filters', tooltip='Détecter les imbalances')
enable_swing_filter = input(true, '📊 Swing High/Low', group='🧠 Smart Money Filters', tooltip='Structure de marché')
enable_reaction_zones = input(true, '🎯 Zones de Réaction', group='🧠 Smart Money Filters', tooltip='Support/Résistance testés')
enable_candle_patterns = input(true, '🕯️ Candlestick Patterns', group='🧠 Smart Money Filters', tooltip='Engulfing, Pin bars')
enable_range_position = input(true, '📏 Position dans Range', group='🧠 Smart Money Filters', tooltip='Éviter milieu de range')

swing_lookback = input.int(10, 'Swing Lookback', minval=3, maxval=50, group='🧠 Smart Money Filters')
reaction_zone_touches = input.int(2, 'Touches minimum zone', minval=2, maxval=5, group='🧠 Smart Money Filters')

// === AFFICHAGE SMART MONEY ===
show_fvg_boxes = input(true, 'Afficher FVG (boxes)', group='🎨 Affichage Smart Money')
show_swing_labels = input(true, 'Afficher Swing Points', group='🎨 Affichage Smart Money')
show_reaction_zones = input(true, 'Afficher Zones Réaction', group='🎨 Affichage Smart Money')

// === AFFICHAGE SESSIONS ===
show_session_boxes = input(true, 'Afficher boxes sessions', group='🎨 Affichage Sessions')
show_session_labels = input(true, 'Afficher labels sessions', group='🎨 Affichage Sessions')
show_session_hl = input(false, 'Afficher High/Low sessions', group='🎨 Affichage Sessions')
session_bg_transp = input.int(90, 'Transparence boxes', minval=0, maxval=100, group='🎨 Affichage Sessions')

// === STRATÉGIES ===
enable_asian_breakout = input(true, '🔥 Asian Breakout', group='📈 Stratégies')
enable_vwap_bounce = input(true, '💎 VWAP Bounce', group='📈 Stratégies')
enable_killzone_entries = input(true, '🎯 Kill Zone Entries', group='📈 Stratégies')

// === INDICATEURS ===
show_vwap = input(true, 'VWAP Daily', group='📊 Indicateurs')
show_ema = input(true, 'EMA9', group='📊 Indicateurs')
ema_period = input.int(9, 'Période EMA', minval=1, group='📊 Indicateurs')

// === RISK MANAGEMENT ===
atr_period = input.int(14, 'Période ATR', minval=1, group='⚠️ Risk Management')
atr_sl_mult = input.float(1.5, 'Multiplicateur ATR pour SL', minval=0.1, step=0.1, group='⚠️ Risk Management')
default_rr = input.float(2.0, 'Risk:Reward', minval=0.5, step=0.5, group='⚠️ Risk Management')

// === FILTRES QUALITÉ ===
min_signal_quality = input.int(70, 'Score minimum signaux (%)', minval=50, maxval=100, group='✅ Filtres Qualité')
volume_filter = input(true, 'Filtre Volume', group='✅ Filtres Qualité')
trend_filter = input(true, 'Filtre Tendance EMA9', group='✅ Filtres Qualité')

// === ALERTES ===
enable_breakout_alerts = input(true, '🔔 Alertes Breakout', group='🔔 Alertes')
enable_vwap_alerts = input(true, '🔔 Alertes VWAP', group='🔔 Alertes')
enable_kz_alerts = input(true, '🔔 Alertes Kill Zones', group='🔔 Alertes')

// === DASHBOARD ===
show_dashboard = input(true, 'Dashboard Info', group='📋 Dashboard')
show_legend = input(true, 'Légende', group='📋 Dashboard')

// ============================================================================
// VARIABLES GLOBALES
// ============================================================================

var string tz = use_exchange_tz ? syminfo.timezone : str.format('UTC{0}{1}', tz_offset >= 0 ? '+' : '-', math.abs(tz_offset))

// Sessions
is_nya = not na(time(timeframe.period, nya_time, tz))
is_ldn = not na(time(timeframe.period, ldn_time, tz))
is_tyo = not na(time(timeframe.period, tyo_time, tz))
is_london_kz = not na(time(timeframe.period, london_kz_time, tz))
is_ny_kz = not na(time(timeframe.period, ny_kz_time, tz))

// Boxes
var box box_nya = na
var box box_ldn = na
var box box_tyo = na
var box box_london_kz = na
var box box_ny_kz = na

// Lines
var line line_tyo_high = na
var line line_tyo_low = na
var line line_ldn_high = na
var line line_ldn_low = na
var line line_nya_high = na
var line line_nya_low = na

// Asian Range
var float asian_high = na
var float asian_low = na
var bool asian_range_valid = false

// ============================================================================
// CALCULS INDICATEURS DE BASE
// ============================================================================

atr = ta.atr(atr_period)
atr_sl_long = close - (atr * atr_sl_mult)
atr_sl_short = close + (atr * atr_sl_mult)

vwap = ta.vwap(close)
ema9 = ta.ema(close, ema_period)

vol_ma = ta.sma(volume, 20)
high_volume = volume > vol_ma

// ============================================================================
// SMART MONEY : FAIR VALUE GAPS (FVG)
// ============================================================================

// Détection FVG Bullish (gap entre high[2] et low[0])
bool fvg_bullish = enable_fvg_filter and (low > high[2]) and close > close[1]
float fvg_bull_top = fvg_bullish ? low : na
float fvg_bull_bottom = fvg_bullish ? high[2] : na

// Détection FVG Bearish (gap entre low[2] et high[0])
bool fvg_bearish = enable_fvg_filter and (high < low[2]) and close < close[1]
float fvg_bear_top = fvg_bearish ? low[2] : na
float fvg_bear_bottom = fvg_bearish ? high : na

// Stocker les FVG récents (pour vérifier si prix est près d'un FVG)
var float[] fvg_bull_tops = array.new_float(0)
var float[] fvg_bull_bottoms = array.new_float(0)
var float[] fvg_bear_tops = array.new_float(0)
var float[] fvg_bear_bottoms = array.new_float(0)

if fvg_bullish
    array.push(fvg_bull_tops, fvg_bull_top)
    array.push(fvg_bull_bottoms, fvg_bull_bottom)
    if array.size(fvg_bull_tops) > 20  // Garder max 20 FVG
        array.shift(fvg_bull_tops)
        array.shift(fvg_bull_bottoms)

if fvg_bearish
    array.push(fvg_bear_tops, fvg_bear_top)
    array.push(fvg_bear_bottoms, fvg_bear_bottom)
    if array.size(fvg_bear_tops) > 20
        array.shift(fvg_bear_tops)
        array.shift(fvg_bear_bottoms)

// Vérifier si prix actuel est près d'un FVG
f_near_fvg_bullish() =>
    bool result = false
    if enable_fvg_filter and array.size(fvg_bull_tops) > 0
        for i = 0 to array.size(fvg_bull_tops) - 1
            float top = array.get(fvg_bull_tops, i)
            float bottom = array.get(fvg_bull_bottoms, i)
            // Prix dans ou juste au-dessus du FVG
            if close >= bottom and close <= top + (atr * 0.5)
                result := true
                break
    result

f_near_fvg_bearish() =>
    bool result = false
    if enable_fvg_filter and array.size(fvg_bear_tops) > 0
        for i = 0 to array.size(fvg_bear_tops) - 1
            float top = array.get(fvg_bear_tops, i)
            float bottom = array.get(fvg_bear_bottoms, i)
            // Prix dans ou juste en-dessous du FVG
            if close <= top and close >= bottom - (atr * 0.5)
                result := true
                break
    result

// Affichage FVG
if show_fvg_boxes and fvg_bullish
    box.new(bar_index - 2, fvg_bull_top, bar_index + 10, fvg_bull_bottom,
      bgcolor = color.new(color.green, 85),
      border_color = color.new(color.green, 50),
      border_width = 1,
      extend = extend.right)

if show_fvg_boxes and fvg_bearish
    box.new(bar_index - 2, fvg_bear_top, bar_index + 10, fvg_bear_bottom,
      bgcolor = color.new(color.red, 85),
      border_color = color.new(color.red, 50),
      border_width = 1,
      extend = extend.right)

// ============================================================================
// SMART MONEY : SWING HIGH / LOW
// ============================================================================

// Détection Swing High (plus haut local)
f_is_swing_high(int lookback) =>
    bool result = true
    for i = 1 to lookback
        if high[i] > high or high[-i] >= high
            result := false
            break
    result

// Détection Swing Low (plus bas local)
f_is_swing_low(int lookback) =>
    bool result = true
    for i = 1 to lookback
        if low[i] < low or low[-i] <= low
            result := false
            break
    result

bool is_swing_high = enable_swing_filter and f_is_swing_high(swing_lookback)
bool is_swing_low = enable_swing_filter and f_is_swing_low(swing_lookback)

// Stocker swing points récents
var float[] swing_highs = array.new_float(0)
var int[] swing_high_bars = array.new_int(0)
var float[] swing_lows = array.new_float(0)
var int[] swing_low_bars = array.new_int(0)

if is_swing_high
    array.push(swing_highs, high)
    array.push(swing_high_bars, bar_index)
    if array.size(swing_highs) > 10
        array.shift(swing_highs)
        array.shift(swing_high_bars)

if is_swing_low
    array.push(swing_lows, low)
    array.push(swing_low_bars, bar_index)
    if array.size(swing_lows) > 10
        array.shift(swing_lows)
        array.shift(swing_low_bars)

// Vérifier si prix actuel est près d'un swing point
f_near_swing_low() =>
    bool result = false
    if enable_swing_filter and array.size(swing_lows) > 0
        for i = 0 to array.size(swing_lows) - 1
            float swing_price = array.get(swing_lows, i)
            if math.abs(close - swing_price) < (atr * 0.3)
                result := true
                break
    result

f_near_swing_high() =>
    bool result = false
    if enable_swing_filter and array.size(swing_highs) > 0
        for i = 0 to array.size(swing_highs) - 1
            float swing_price = array.get(swing_highs, i)
            if math.abs(close - swing_price) < (atr * 0.3)
                result := true
                break
    result

// Affichage Swing Points
if show_swing_labels and is_swing_high
    label.new(bar_index, high, 'SH',
      color = color.new(color.red, 30),
      textcolor = color.white,
      style = label.style_label_down,
      size = size.tiny)

if show_swing_labels and is_swing_low
    label.new(bar_index, low, 'SL',
      color = color.new(color.green, 30),
      textcolor = color.white,
      style = label.style_label_up,
      size = size.tiny)

// ============================================================================
// SMART MONEY : ZONES DE RÉACTION
// ============================================================================

// Détecter si un niveau de prix a été touché plusieurs fois
var float[] reaction_levels = array.new_float(0)
var int[] reaction_counts = array.new_int(0)

// Fonction pour arrondir le prix à un niveau
f_round_price(float price, float precision) =>
    math.round(price / precision) * precision

// Mise à jour des zones de réaction
if enable_reaction_zones
    float current_level = f_round_price(low, atr * 0.1)

    // Chercher si ce niveau existe déjà
    int found_idx = -1
    if array.size(reaction_levels) > 0
        for i = 0 to array.size(reaction_levels) - 1
            float level = array.get(reaction_levels, i)
            if math.abs(current_level - level) < (atr * 0.1)
                found_idx := i
                break

    // Incrémenter le compteur ou créer nouveau niveau
    if found_idx >= 0
        int current_count = array.get(reaction_counts, found_idx)
        array.set(reaction_counts, found_idx, current_count + 1)
    else
        array.push(reaction_levels, current_level)
        array.push(reaction_counts, 1)

        // Limiter à 50 zones
        if array.size(reaction_levels) > 50
            array.shift(reaction_levels)
            array.shift(reaction_counts)

// Vérifier si prix actuel est sur une zone de réaction
f_at_reaction_zone(int min_touches) =>
    bool result = false
    if enable_reaction_zones and array.size(reaction_levels) > 0
        for i = 0 to array.size(reaction_levels) - 1
            float level = array.get(reaction_levels, i)
            int touches = array.get(reaction_counts, i)

            if touches >= min_touches and math.abs(close - level) < (atr * 0.2)
                result := true
                break
    result

// ============================================================================
// SMART MONEY : CANDLESTICK PATTERNS
// ============================================================================

// Engulfing Bullish
bool bullish_engulfing = enable_candle_patterns and
  close > open and
  close[1] < open[1] and
  close > open[1] and
  open < close[1] and
  (close - open) > (open[1] - close[1]) * 0.8

// Engulfing Bearish
bool bearish_engulfing = enable_candle_patterns and
  close < open and
  close[1] > open[1] and
  close < open[1] and
  open > close[1] and
  (open - close) > (close[1] - open[1]) * 0.8

// Pin Bar Bullish (long wick en bas)
float body_size = math.abs(close - open)
float lower_wick = math.min(open, close) - low
float upper_wick = high - math.max(open, close)

bool bullish_pinbar = enable_candle_patterns and
  lower_wick > body_size * 2 and
  lower_wick > upper_wick * 2 and
  close > open

// Pin Bar Bearish (long wick en haut)
bool bearish_pinbar = enable_candle_patterns and
  upper_wick > body_size * 2 and
  upper_wick > lower_wick * 2 and
  close < open

// ============================================================================
// SMART MONEY : POSITION DANS LE RANGE
// ============================================================================

// Calculer position dans le range des X dernières bougies
int range_lookback = 50
float range_high = ta.highest(high, range_lookback)
float range_low = ta.lowest(low, range_lookback)
float range_size = range_high - range_low
float position_in_range = range_size > 0 ? ((close - range_low) / range_size) * 100 : 50

// Bon positionnement : lower 30% pour LONG, upper 30% pour SHORT
bool good_position_long = enable_range_position and position_in_range < 30
bool good_position_short = enable_range_position and position_in_range > 70

// ============================================================================
// FONCTION DE SCORING AMÉLIORÉE
// ============================================================================

f_calculate_quality_score(bool is_long, bool is_with_trend, bool is_high_vol, float dist_vwap, bool in_kz) =>
    float score = 40.0  // Base réduite à 40

    // Critères de base (30 points max)
    if is_with_trend
        score += 10  // Réduit de 20 à 10
    if is_high_vol
        score += 10  // Réduit de 15 à 10

    float vwap_dist_pct = math.abs(dist_vwap / close) * 100
    if vwap_dist_pct < 0.1
        score += 5
    else if vwap_dist_pct < 0.3
        score += 3

    if in_kz
        score += 5

    // NOUVEAUX FILTRES SMART MONEY (60 points max)

    // FVG : +15 points
    if is_long and f_near_fvg_bullish()
        score += 15
    if not is_long and f_near_fvg_bearish()
        score += 15

    // Swing Points : +15 points
    if is_long and f_near_swing_low()
        score += 15
    if not is_long and f_near_swing_high()
        score += 15

    // Zone de réaction : +10 points
    if f_at_reaction_zone(reaction_zone_touches)
        score += 10

    // Candlestick Patterns : +15 points (engulfing) ou +10 (pinbar)
    if is_long
        if bullish_engulfing
            score += 15
        else if bullish_pinbar
            score += 10
    else
        if bearish_engulfing
            score += 15
        else if bearish_pinbar
            score += 10

    // Position dans le range : +5 points
    if is_long and good_position_long
        score += 5
    if not is_long and good_position_short
        score += 5

    math.min(score, 100)

// ============================================================================
// FONCTIONS D'AFFICHAGE SESSIONS (simplifiées)
// ============================================================================

f_draw_session(bool active, box bx, color col, string name) =>
    var box result = bx
    var label lbl = na
    var int start_bar = na
    var float sess_high = na
    var float sess_low = na

    if active and active != active[1]
        start_bar := bar_index
        sess_high := high
        sess_low := low

        if show_session_boxes
            result := box.new(bar_index, high, bar_index, low,
              bgcolor = color.new(col, session_bg_transp),
              border_color = color.new(col, 0),
              border_style = line.style_dotted)

        if show_session_labels
            lbl := label.new(bar_index, high, name,
              color = color.new(col, 30),
              textcolor = color.white,
              style = label.style_label_down,
              size = size.small)

    if active
        sess_high := math.max(sess_high, high)
        sess_low := math.min(sess_low, low)

        if not na(result)
            box.set_top(result, sess_high)
            box.set_bottom(result, sess_low)
            box.set_right(result, bar_index)

        if not na(lbl)
            label.set_xy(lbl, math.round((start_bar + bar_index) / 2), sess_high)

    [result, sess_high, sess_low]

f_draw_kz(bool active, box bx, color col, string name) =>
    var box result = bx

    if active and active != active[1]
        result := box.new(bar_index, high, bar_index, low,
          bgcolor = color.new(col, 92),
          border_color = col,
          border_width = 2)

        label.new(bar_index, high, name,
          color = col,
          textcolor = color.white,
          style = label.style_label_down,
          size = size.tiny)

    if active and not na(result)
        box.set_top(result, math.max(box.get_top(result), high))
        box.set_bottom(result, math.min(box.get_bottom(result), low))
        box.set_right(result, bar_index)

    result

// ============================================================================
// AFFICHAGE DES SESSIONS
// ============================================================================

if show_nya
    [bx, h, l] = f_draw_session(is_nya, box_nya, nya_color, nya_name)
    box_nya := bx

if show_ldn
    [bx, h, l] = f_draw_session(is_ldn, box_ldn, ldn_color, ldn_name)
    box_ldn := bx

var float tyo_high = na
var float tyo_low = na
if show_tyo
    [bx, h, l] = f_draw_session(is_tyo, box_tyo, tyo_color, tyo_name)
    box_tyo := bx
    tyo_high := h
    tyo_low := l

if show_kz
    box_london_kz := f_draw_kz(is_london_kz, box_london_kz, london_kz_color, '🎯 LONDON KZ')
    box_ny_kz := f_draw_kz(is_ny_kz, box_ny_kz, ny_kz_color, '🎯 NY KZ')

// ============================================================================
// ASIAN RANGE
// ============================================================================

if is_tyo
    if is_tyo != is_tyo[1]
        asian_high := high
        asian_low := low
        asian_range_valid := false
    else
        asian_high := math.max(asian_high, high)
        asian_low := math.min(asian_low, low)

if is_tyo[1] and not is_tyo
    asian_range_valid := true

if asian_range_valid and (ta.crossover(close, asian_high) or ta.crossunder(close, asian_low))
    asian_range_valid := false

// ============================================================================
// STRATÉGIE 1 : ASIAN BREAKOUT
// ============================================================================

bool breakout_long = false
bool breakout_short = false
float breakout_quality = na

if enable_asian_breakout and asian_range_valid
    float asian_range = asian_high - asian_low

    if is_ldn and ta.crossover(close, asian_high)
        breakout_long := true
        bool with_trend = close > ema9
        bool in_kz = is_london_kz
        breakout_quality := f_calculate_quality_score(true, with_trend, high_volume, close - vwap, in_kz)

    if is_ldn and ta.crossunder(close, asian_low)
        breakout_short := true
        bool with_trend = close < ema9
        bool in_kz = is_london_kz
        breakout_quality := f_calculate_quality_score(false, with_trend, high_volume, vwap - close, in_kz)

// ============================================================================
// STRATÉGIE 2 : VWAP BOUNCE
// ============================================================================

bool vwap_long = false
bool vwap_short = false
float vwap_quality = na

if enable_vwap_bounce
    float dist = math.abs(close - vwap)
    bool near = dist < (atr * 0.3)

    if near and ta.crossover(close, vwap) and close > vwap
        bool with_trend = close > ema9
        bool ok = (not trend_filter or with_trend) and (not volume_filter or high_volume)

        if ok
            vwap_long := true
            bool in_kz = is_london_kz or is_ny_kz
            vwap_quality := f_calculate_quality_score(true, with_trend, high_volume, dist, in_kz)

    if near and ta.crossunder(close, vwap) and close < vwap
        bool with_trend = close < ema9
        bool ok = (not trend_filter or with_trend) and (not volume_filter or high_volume)

        if ok
            vwap_short := true
            bool in_kz = is_london_kz or is_ny_kz
            vwap_quality := f_calculate_quality_score(false, with_trend, high_volume, dist, in_kz)

// ============================================================================
// STRATÉGIE 3 : KILL ZONE ENTRIES
// ============================================================================

bool kz_long = false
bool kz_short = false
float kz_quality = na
string kz_name = na

if enable_killzone_entries
    bool in_kz = is_london_kz or is_ny_kz

    if in_kz
        if close > vwap and ta.crossover(close, ema9)
            bool ok = not volume_filter or high_volume

            if ok
                kz_long := true
                kz_name := is_london_kz ? 'LONDON KZ' : 'NY KZ'
                kz_quality := f_calculate_quality_score(true, true, high_volume, close - vwap, true)

        if close < vwap and ta.crossunder(close, ema9)
            bool ok = not volume_filter or high_volume

            if ok
                kz_short := true
                kz_name := is_london_kz ? 'LONDON KZ' : 'NY KZ'
                kz_quality := f_calculate_quality_score(false, true, high_volume, vwap - close, true)

// ============================================================================
// AFFICHAGE DES SIGNAUX
// ============================================================================

// Helper pour créer les labels
f_create_signal_label(bool is_long, string strategy, float entry, float sl, float tp, float quality, string extra_info) =>
    string direction = is_long ? '🔼 LONG' : '🔽 SHORT'
    string rr_text = str.tostring((tp - entry) / (entry - sl), '#.##')

    // Ajouter badges selon filtres actifs
    string badges = ''
    if is_long
        badges += f_near_fvg_bullish() ? '⚡FVG ' : ''
        badges += f_near_swing_low() ? '📊SL ' : ''
        badges += bullish_engulfing ? '🕯️ENG ' : bullish_pinbar ? '🕯️PIN ' : ''
    else
        badges += f_near_fvg_bearish() ? '⚡FVG ' : ''
        badges += f_near_swing_high() ? '📊SH ' : ''
        badges += bearish_engulfing ? '🕯️ENG ' : bearish_pinbar ? '🕯️PIN ' : ''

    badges += f_at_reaction_zone(reaction_zone_touches) ? '🎯RZ ' : ''

    string text = direction + ' ' + strategy + '\n' +
      (badges != '' ? badges + '\n━━━━━━━━\n' : '━━━━━━━━\n') +
      '💰 ' + str.tostring(entry, format.mintick) + '\n' +
      '🛡️ ' + str.tostring(sl, format.mintick) + '\n' +
      '🎯 ' + str.tostring(tp, format.mintick) + '\n' +
      '📊 RR: 1:' + rr_text + '\n' +
      '✅ ' + str.tostring(quality, '#') + '%' +
      (extra_info != '' ? '\n' + extra_info : '')

    text

// Asian Breakout
if breakout_long and breakout_quality >= min_signal_quality
    float entry = close
    float sl = asian_low
    float tp = asian_high + ((asian_high - asian_low) * default_rr)

    string text = f_create_signal_label(true, 'ASIAN BO', entry, sl, tp, breakout_quality, '')
    label.new(bar_index, low, text,
      color = color.new(color.green, 0),
      textcolor = color.white,
      style = label.style_label_up,
      size = size.normal)

if breakout_short and breakout_quality >= min_signal_quality
    float entry = close
    float sl = asian_high
    float tp = asian_low - ((asian_high - asian_low) * default_rr)

    string text = f_create_signal_label(false, 'ASIAN BO', entry, sl, tp, breakout_quality, '')
    label.new(bar_index, high, text,
      color = color.new(color.red, 0),
      textcolor = color.white,
      style = label.style_label_down,
      size = size.normal)

// VWAP Bounce
if vwap_long and vwap_quality >= min_signal_quality
    float entry = close
    float sl = atr_sl_long
    float tp = entry + ((entry - sl) * default_rr)

    string text = f_create_signal_label(true, 'VWAP', entry, sl, tp, vwap_quality, '')
    label.new(bar_index, low, text,
      color = color.new(color.lime, 20),
      textcolor = color.black,
      style = label.style_label_up,
      size = size.small)

if vwap_short and vwap_quality >= min_signal_quality
    float entry = close
    float sl = atr_sl_short
    float tp = entry - ((sl - entry) * default_rr)

    string text = f_create_signal_label(false, 'VWAP', entry, sl, tp, vwap_quality, '')
    label.new(bar_index, high, text,
      color = color.new(color.orange, 20),
      textcolor = color.black,
      style = label.style_label_down,
      size = size.small)

// Kill Zones
if kz_long and kz_quality >= min_signal_quality
    float entry = close
    float sl = atr_sl_long
    float tp = entry + ((entry - sl) * default_rr)

    string text = f_create_signal_label(true, kz_name, entry, sl, tp, kz_quality, '')
    label.new(bar_index, low, text,
      color = color.new(color.blue, 20),
      textcolor = color.white,
      style = label.style_label_up,
      size = size.small)

if kz_short and kz_quality >= min_signal_quality
    float entry = close
    float sl = atr_sl_short
    float tp = entry - ((sl - entry) * default_rr)

    string text = f_create_signal_label(false, kz_name, entry, sl, tp, kz_quality, '')
    label.new(bar_index, high, text,
      color = color.new(color.purple, 20),
      textcolor = color.white,
      style = label.style_label_down,
      size = size.small)

// ============================================================================
// PLOTS
// ============================================================================

plot(show_vwap ? vwap : na, 'VWAP', color.yellow, 2)
plot(show_ema ? ema9 : na, 'EMA9', color.aqua, 1)

// ============================================================================
// DASHBOARD
// ============================================================================

if show_dashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 12,
      bgcolor = color.new(#1a1a1a, 10),
      border_color = color.gray,
      border_width = 1)

    table.cell(dash, 0, 0, '📊 SMART MONEY v3',
      text_color = color.white,
      bgcolor = color.new(color.blue, 30),
      text_size = size.normal)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Indicateurs classiques
    table.cell(dash, 0, 1, 'ATR', text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 1, str.tostring(atr, format.mintick), text_color = color.yellow, text_size = size.small)

    table.cell(dash, 0, 2, 'VWAP', text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(vwap, format.mintick), text_color = color.yellow, text_size = size.small)

    string vwap_pos = close > vwap ? '🟢 DESSUS' : '🔴 DESSOUS'
    table.cell(dash, 0, 3, 'Position', text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 3, vwap_pos, text_color = close > vwap ? color.green : color.red, text_size = size.small)

    // Smart Money Filters
    table.cell(dash, 0, 4, '🧠 SMART FILTERS', text_color = color.white, text_size = size.small, bgcolor = color.new(color.purple, 70))
    table.merge_cells(dash, 0, 4, 1, 4)

    string fvg_status = f_near_fvg_bullish() ? '⚡BULL' : f_near_fvg_bearish() ? '⚡BEAR' : '⚪OFF'
    table.cell(dash, 0, 5, 'FVG', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 5, fvg_status, text_color = color.white, text_size = size.tiny)

    string swing_status = f_near_swing_low() ? '📊 LOW' : f_near_swing_high() ? '📊 HIGH' : '⚪OFF'
    table.cell(dash, 0, 6, 'Swing', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 6, swing_status, text_color = color.white, text_size = size.tiny)

    string rz_status = f_at_reaction_zone(reaction_zone_touches) ? '🎯 YES' : '⚪ NO'
    table.cell(dash, 0, 7, 'React Zone', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 7, rz_status, text_color = color.white, text_size = size.tiny)

    string candle_status = bullish_engulfing or bearish_engulfing ? '🕯️ENG' :
                          bullish_pinbar or bearish_pinbar ? '🕯️PIN' : '⚪OFF'
    table.cell(dash, 0, 8, 'Pattern', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 8, candle_status, text_color = color.white, text_size = size.tiny)

    string range_status = str.tostring(position_in_range, '#') + '%'
    color range_col = good_position_long ? color.green : good_position_short ? color.red : color.gray
    table.cell(dash, 0, 9, 'Range Pos', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 9, range_status, text_color = range_col, text_size = size.tiny)

    // Session
    string session = is_london_kz ? '🎯 LONDON' : is_ny_kz ? '🎯 NY' :
                    is_ldn ? '🇬🇧 LDN' : is_nya ? '🇺🇸 NY' : is_tyo ? '🇯🇵 TYO' : '💤'
    table.cell(dash, 0, 10, 'Session', text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 10, session, text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 11, '💡 TIP', text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.orange, 70))
    table.cell(dash, 1, 11, 'Wait 80%+', text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.orange, 70))

// ============================================================================
// LÉGENDE
// ============================================================================

if show_legend and barstate.islast
    float chart_range = ta.highest(high, 200) - ta.lowest(low, 200)
    float y_pos = low - (chart_range * 0.05)

    label.new(bar_index, y_pos,
      text = '⚡FVG | 📊Swing | 🎯React | 🕯️Pattern | 📏Range | ✅Score',
      style = label.style_label_up,
      color = color.new(#1a1a1a, 10),
      textcolor = color.white,
      size = size.small)
